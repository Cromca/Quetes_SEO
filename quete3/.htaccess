DirectoryIndex index.html
RewriteEngine On

# L'ancienne URL du produit redirige vers une adresse descriptive.
RewriteCond %{QUERY_STRING} ^id=42$
RewriteRule ^produite?$ /produits/velo-electrique-pliable [R=301,L,QSD]

RewriteCond %{QUERY_STRING} ^id=43$
RewriteRule ^produite?$ /produits/velo-electrique-ville [R=301,L,QSD]

# Ne pas exposer une seconde adresse pour la même fiche produit.
RewriteCond %{THE_REQUEST} \s/+produit\.html(?:[?\s]) [NC]
RewriteRule ^produit\.html$ /produits/velo-electrique-pliable [R=301,L]

RewriteRule ^produits/velo-electrique-pliable/$ /produits/velo-electrique-pliable [R=301,L]
RewriteRule ^produits/velo-electrique-pliable$ produit.html [END]

RewriteCond %{THE_REQUEST} \s/+produit-ville\.html(?:[?\s]) [NC]
RewriteRule ^produit-ville\.html$ /produits/velo-electrique-ville [R=301,L]

RewriteRule ^produits/velo-electrique-ville/$ /produits/velo-electrique-ville [R=301,L]
RewriteRule ^produits/velo-electrique-ville$ produit-ville.html [END]
